<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status Absensi | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="main-content">
    <section class="content-card form-card text-center">
        <% if (success === true || success === 'true') { %>
            <span class="value-badge">Amanah Tercatat</span>
            <h2>✅ Absensi Berhasil</h2>
            <div class="islamic-message-box">
                <h3>Semoga Menjadi Ilmu yang Bermanfaat</h3>
                <p>Kehadiran yang jujur adalah bagian dari ikhtiar menuntut ilmu dengan penuh tanggung jawab.</p>
            </div>
            <div class="alert alert-success"><%= message || 'Absensi berhasil disimpan.' %></div>
        <% } else { %>
            <span class="value-badge">Evaluasi Kejujuran</span>
            <h2>❌ Absensi Gagal</h2>
            <div class="islamic-message-box">
                <h3>Jujur adalah Bagian dari Amanah</h3>
                <p>Silakan periksa kembali QR, lokasi, dan status kehadiran Anda.</p>
            </div>
            <div class="alert alert-error"><%= message || 'Absensi gagal diproses.' %></div>
        <% } %>
        <a href="/dashboard" class="btn-primary">Kembali ke Dashboard</a>
    </section>
</main>

<div id="attendancePopup" class="attendance-popup" hidden>
    <div class="attendance-popup__backdrop" onclick="closeAttendancePopup()"></div>
    <div class="attendance-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="attendancePopupTitle">
        <span id="attendancePopupBadge" class="attendance-popup__badge">Status Absensi</span>
        <h2 id="attendancePopupTitle">Absensi</h2>
        <p id="attendancePopupMessage"></p>
        <button type="button" class="btn-primary" onclick="closeAttendancePopup()">Tutup</button>
    </div>
</div>

<script>
const attendancePopup = document.getElementById('attendancePopup');
const attendancePopupBadge = document.getElementById('attendancePopupBadge');
const attendancePopupTitle = document.getElementById('attendancePopupTitle');
const attendancePopupMessage = document.getElementById('attendancePopupMessage');
const attendanceSuccess = <%- JSON.stringify(success === true || success === 'true') %>;
const attendanceMessage = <%- JSON.stringify(message || (success === true || success === 'true' ? 'Absensi berhasil disimpan.' : 'Absensi gagal diproses.')).replace(/</g, '\\u003c') %>;

function closeAttendancePopup() {
    attendancePopup.hidden = true;
}

window.addEventListener('load', () => {
    attendancePopup.classList.toggle('is-success', attendanceSuccess);
    attendancePopup.classList.toggle('is-error', !attendanceSuccess);
    attendancePopupBadge.innerText = attendanceSuccess ? 'Absensi Berhasil' : 'Absensi Gagal';
    attendancePopupTitle.innerText = attendanceSuccess ? 'Absensi berhasil' : 'Absensi gagal';
    attendancePopupMessage.innerText = attendanceMessage;
    attendancePopup.hidden = false;
});
</script>
</body>
</html>
