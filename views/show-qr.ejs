<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Absensi | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="main-content">
    <section class="content-card qr-page-card">
        <div class="qr-header">
            <div>
                <span class="value-badge">QR Dinamis · Amanah Digital</span>
                <h2>📱 QR Absensi</h2>
                <p>QR dapat discan banyak mahasiswa, tetapi setiap akun hanya dapat absen satu kali per sesi.</p>
            </div>
            <a href="/dashboard" class="btn-secondary">Kembali</a>
        </div>

        <div class="qr-session-info">
            <div><span>Mata Kuliah</span><strong><%= session.subject_name || '-' %></strong></div>
            <div><span>Pertemuan</span><strong><%= session.judul || 'Tanpa Judul' %></strong></div>
            <div><span>Berakhir</span><strong><%= session.expires_at %></strong></div>
        </div>

        <% if (!classSetting || !classSetting.latitude || !classSetting.longitude) { %>
            <div class="alert alert-error">Lokasi kelas belum diatur. Absensi GPS akan gagal sampai admin/kosma/dosen menyimpan titik kelas.</div>
        <% } else { %>
            <div class="alert alert-success">Lokasi kelas aktif: <%= classSetting.class_name || 'Lokasi Kelas' %> · Radius 500 meter.</div>
        <% } %>

        <% if (canUseCreatorButton) { %>
            <div class="islamic-message-box">
                <h3>Status Kehadiran Pembuat Sesi</h3>
                <% if (ownAttendance) { %>
                    <p>✅ Kamu sudah tercatat hadir dengan metode <strong><%= ownAttendance.method %></strong>.</p>
                <% } else { %>
                    <p>Kamu adalah pembuat sesi. Klik tombol berikut agar kehadiranmu tercatat. GPS tetap wajib valid.</p>
                    <button type="button" class="btn-primary" onclick="creatorPresent()">Saya Hadir</button>
                    <p id="creatorStatus" class="info"></p>
                <% } %>
            </div>
        <% } %>

        <div class="qr-display-box">
            <div id="qr-loading" class="qr-loading">Membuat QR Code...</div>
            <img id="qr-image" src="" alt="QR Code Absensi" style="display:none;">
        </div>

        <div class="qr-footer-info">
            <p>QR diperbarui otomatis setiap <strong>30 detik</strong>. Token aktif singkat untuk mengurangi penyebaran screenshot.</p>
            <p id="qr-status">Menunggu QR aktif...</p>
        </div>

        <section class="attendance-live-card">
            <div class="dashboard-section-header">
                <div>
                    <h2>Daftar Hadir Realtime</h2>
                    <p>Mahasiswa yang berhasil scan dan lolos GPS akan otomatis muncul di sini.</p>
                </div>
                <span class="badge hadir" id="attendance-count">0 Hadir</span>
            </div>
            <div id="attendance-status" class="info-box">Memuat daftar hadir...</div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>NIM</th>
                            <th>Nama</th>
                            <th>Waktu</th>
                            <th>Metode</th>
                            <th>Jarak</th>
                        </tr>
                    </thead>
                    <tbody id="attendance-body">
                        <tr><td colspan="5">Belum ada mahasiswa yang hadir.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </section>
</main>

<script>
    const sessionId = '<%= session.id %>';
    const csrfToken = '<%= csrfToken %>';
    const qrImage = document.getElementById('qr-image');
    const qrLoading = document.getElementById('qr-loading');
    const qrStatus = document.getElementById('qr-status');
    const attendanceCount = document.getElementById('attendance-count');
    const attendanceStatus = document.getElementById('attendance-status');
    const attendanceBody = document.getElementById('attendance-body');

    function escapeHtml(value) {
        return String(value ?? '-')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    async function loadQrCode() {
        try {
            qrLoading.style.display = 'block';
            qrLoading.innerText = 'Membuat QR Code...';
            qrStatus.innerText = 'Memperbarui QR Code...';

            const response = await fetch(`/api/qr-token/${sessionId}`, { headers: { 'Accept': 'application/json' } });
            const data = await response.json();

            if (!response.ok || !data.success) {
                qrImage.style.display = 'none';
                qrLoading.style.display = 'block';
                qrLoading.innerText = data.message || 'Gagal membuat QR Code.';
                qrStatus.innerText = 'QR tidak aktif.';
                return;
            }

            qrImage.src = data.qrCode;
            qrImage.style.display = 'block';
            qrLoading.style.display = 'none';
            qrStatus.innerText = 'QR aktif. Silakan scan menggunakan akun mahasiswa.';
        } catch (error) {
            qrImage.style.display = 'none';
            qrLoading.style.display = 'block';
            qrLoading.innerText = 'Gagal memuat QR Code.';
            qrStatus.innerText = 'Terjadi kesalahan koneksi.';
        }
    }

    async function creatorPresent() {
        const status = document.getElementById('creatorStatus');
        status.innerText = 'Mengambil lokasi GPS...';

        if (!navigator.geolocation) {
            status.innerText = 'Browser tidak mendukung GPS.';
            return;
        }

        navigator.geolocation.getCurrentPosition(async function(position) {
            try {
                const response = await fetch(`/api/creator-present/${sessionId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
                    body: JSON.stringify({
                        latitude: position.coords.latitude,
                        longitude: position.coords.longitude,
                        gps_accuracy: position.coords.accuracy
                    })
                });
                const data = await response.json();
                status.innerText = data.message || 'Selesai.';
                if (data.success) setTimeout(() => window.location.reload(), 1200);
            } catch (error) {
                status.innerText = 'Gagal mengirim kehadiran.';
            }
        }, function() {
            status.innerText = 'Gagal mengambil GPS. Pastikan izin lokasi aktif.';
        }, { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 });
    }

    async function loadAttendance() {
        try {
            const response = await fetch(`/api/sessions/${sessionId}/attendance`, { headers: { 'Accept': 'application/json' } });
            const data = await response.json();

            if (!response.ok || !data.success) {
                attendanceStatus.textContent = data.message || 'Gagal memuat daftar hadir.';
                return;
            }

            attendanceCount.textContent = `${data.count} Hadir`;
            attendanceStatus.textContent = `Terakhir diperbarui ${new Date().toLocaleTimeString('id-ID')}. Total mahasiswa aktif: ${data.totalStudents}.`;

            if (!data.attendees || data.attendees.length === 0) {
                attendanceBody.innerHTML = '<tr><td colspan="5">Belum ada mahasiswa yang hadir.</td></tr>';
                return;
            }

            attendanceBody.innerHTML = data.attendees.map((item) => {
                const distance = item.distance_meters === null || item.distance_meters === undefined
                    ? '-'
                    : `${Math.round(Number(item.distance_meters))} m`;
                return `
                    <tr>
                        <td>${escapeHtml(item.nim)}</td>
                        <td><strong>${escapeHtml(item.nama)}</strong></td>
                        <td>${escapeHtml(item.created_at)}</td>
                        <td>${escapeHtml(item.method)}</td>
                        <td>${escapeHtml(distance)}</td>
                    </tr>
                `;
            }).join('');
        } catch (error) {
            attendanceStatus.textContent = 'Gagal memperbarui daftar hadir.';
        }
    }

    loadQrCode();
    loadAttendance();
    setInterval(loadQrCode, 30000);
    setInterval(loadAttendance, 3000);
</script>
</body>
</html>
