<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="main-content">
    <section class="content-card islamic-hero">
        <span class="value-badge">Portal Digital Kelas</span>
        <h2>Informatika A 2024</h2>
        <p>Dashboard ini mengelola informasi kelas, mata kuliah, PJ, QR attendance, validasi GPS, dan rekap kehadiran.</p>
    </section>

    <section class="stats-grid">
        <div class="stat-card"><p>Mahasiswa Aktif</p><h2><%= stats.totalMahasiswa || 0 %></h2></div>
        <div class="stat-card"><p>Mata Kuliah</p><h2><%= stats.totalSubjects || 0 %></h2></div>
        <div class="stat-card"><p>Sesi Aktif</p><h2><%= stats.activeSessions || 0 %></h2></div>
    </section>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (user.role === 'admin' || Number(user.is_kosma || 0) === 1) { %>
        <section class="dashboard-editorial-grid">
            <article class="content-card news-composer-card">
                <div class="dashboard-section-header">
                    <div>
                        <span class="value-badge">Dari Iman ke Aksi</span>
                        <h2>Kelola Berita Kelas</h2>
                        <p>Tulis kabar kelas yang menonjolkan Shidiq, Amanah, ilmu, dan adab.</p>
                    </div>
                </div>

                <form action="/announcements/create" method="POST" class="news-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>
                        Judul Berita
                        <input type="text" name="title" placeholder="Contoh: Kajian Adab Menuntut Ilmu" required>
                    </label>
                    <div class="form-row">
                        <label>
                            Waktu
                            <input type="datetime-local" name="published_at">
                        </label>
                        <label>
                            Visibilitas
                            <select name="visibility">
                                <option value="public">Publik</option>
                                <option value="private">Internal</option>
                            </select>
                        </label>
                    </div>
                    <label>
                        Link Foto
                        <input type="url" name="image_url" placeholder="https://...">
                    </label>
                    <label>
                        Narasi
                        <textarea name="content" rows="6" placeholder="Tulis narasi singkat, jernih, dan bernilai..." required></textarea>
                    </label>
                    <button type="submit" class="btn-primary full-width">Terbitkan Berita</button>
                </form>
            </article>

            <article class="content-card news-admin-card">
                <div class="dashboard-section-header">
                    <div>
                        <h2>Berita Terbaru</h2>
                        <p>Berita publik tampil di halaman index.</p>
                    </div>
                </div>

                <% if (!announcements || announcements.length === 0) { %>
                    <div class="empty-state">Belum ada berita.</div>
                <% } else { %>
                    <div class="news-admin-list">
                        <% announcements.forEach(item => { %>
                            <article class="news-admin-item">
                                <div class="news-admin-thumb <% if (!item.image_url) { %>news-thumb-empty<% } %>">
                                    <% if (item.image_url) { %>
                                        <img src="<%= item.image_url %>" alt="<%= item.title %>">
                                    <% } else { %>
                                        <span>AM</span>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="news-meta"><%= item.published_at || item.created_at || '-' %> · <%= item.visibility || 'public' %></div>
                                    <strong><%= item.title %></strong>
                                    <p><%= item.content.length > 90 ? item.content.substring(0, 90) + '...' : item.content %></p>
                                </div>
                                <form action="/announcements/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Hapus berita ini?')">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn-small-danger">Hapus</button>
                                </form>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </article>
        </section>
    <% } %>

    <% if (user.role === 'admin' || user.role === 'lecturer' || Number(user.is_kosma || 0) === 1) { %>
        <section class="content-card">
            <div class="dashboard-section-header">
                <div>
                    <h2>📚 Daftar Sesi Terbaru</h2>
                    <p>Admin, Kosma, dan Dosen dapat melihat sesi sesuai aksesnya.</p>
                </div>
                <div class="button-row dashboard-action-row">
                    <a href="/attendance-reports" class="btn-secondary">Cetak Laporan</a>
                    <a href="/create-session" class="btn-primary">Buat Sesi</a>
                </div>
            </div>

            <% if (!sessions || sessions.length === 0) { %>
                <div class="empty-state">Belum ada sesi.</div>
            <% } else { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Mata Kuliah</th>
                                <th>Judul</th>
                                <th>Dibuat</th>
                                <th>Berakhir</th>
                                <th>Hadir</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% sessions.forEach(session => { %>
                                <tr>
                                    <td><%= session.subject_name || '-' %></td>
                                    <td><strong><%= session.judul || 'Tanpa Judul' %></strong></td>
                                    <td><%= session.created_at || '-' %></td>
                                    <td><%= session.expires_at || '-' %></td>
                                    <td><span class="badge hadir"><%= session.hadir || 0 %> Hadir</span></td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="/show-qr/<%= session.id %>" class="btn-small">Lihat QR & Hadir</a>
                                            <a href="/attendance-reports?subject_id=<%= session.subject_id %>&session_id=<%= session.id %>" class="btn-small">Cetak</a>
                                            <form action="/delete-session/<%= session.id %>" method="POST" onsubmit="return confirm('Nonaktifkan sesi ini?')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-small-danger">Nonaktifkan</button>
                                            </form>
                                            <form action="/sessions/<%= session.id %>/delete" method="POST" onsubmit="return confirm('Hapus permanen sesi ini? Daftar hadir dan token QR sesi ini ikut terhapus.')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-small-danger">Hapus</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    <% } else { %>
        <% if (pjSubjects && pjSubjects.length > 0) { %>
            <section class="content-card">
                <div class="dashboard-section-header">
                    <div>
                        <h2>🧩 Akses PJ Saya</h2>
                        <p>Kamu dapat membuat sesi dan mencetak laporan untuk mata kuliah berikut.</p>
                    </div>
                    <div class="button-row dashboard-action-row">
                        <a href="/attendance-reports" class="btn-secondary">Cetak Laporan</a>
                        <a href="/create-session" class="btn-primary">Buat Sesi PJ</a>
                    </div>
                </div>
                <div class="table-wrapper">
                    <table>
                        <thead><tr><th>Kode</th><th>Mata Kuliah</th><th>Semester</th></tr></thead>
                        <tbody>
                            <% pjSubjects.forEach(subject => { %>
                                <tr><td><%= subject.code || '-' %></td><td><%= subject.name %></td><td><%= subject.semester || '-' %></td></tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>

        <section class="content-card">
            <div class="dashboard-section-header">
                <div>
                    <h2>📋 Riwayat Absensi Saya</h2>
                    <p>Scan QR saat sesi aktif dan pastikan GPS aktif.</p>
                </div>
                <a href="/scan" class="btn-primary">📷 Scan QR</a>
            </div>

            <% if (!attendanceHistory || attendanceHistory.length === 0) { %>
                <div class="empty-state">Belum ada riwayat absensi.</div>
            <% } else { %>
                <div class="table-wrapper">
                    <table>
                        <thead><tr><th>Mata Kuliah</th><th>Pertemuan</th><th>Waktu</th><th>Status</th><th>Metode</th></tr></thead>
                        <tbody>
                            <% attendanceHistory.forEach(item => { %>
                                <tr>
                                    <td><%= item.subject_name || '-' %></td>
                                    <td><%= item.judul %></td>
                                    <td><%= item.created_at || '-' %></td>
                                    <td><span class="badge <%= item.status === 'hadir' ? 'hadir' : 'alpha' %>"><%= item.status %></span></td>
                                    <td><%= item.method || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    <% } %>
</main>
</body>
</html>
