<%
    const currentUser = typeof user !== 'undefined' ? user : null;
    const currentRole = currentUser ? currentUser.role : null;
    const isAdminUser = currentUser && currentRole === 'admin';
    const isLecturerUser = currentUser && currentRole === 'lecturer';
    const isStudentUser = currentUser && currentRole === 'student';
    const isKosmaUser = currentUser && Number(currentUser.is_kosma || 0) === 1;
    const iconPath = '/img/icons/';
    const canUseReportMenu = typeof canUseReports !== 'undefined'
        ? canUseReports
        : (isAdminUser || isKosmaUser || isLecturerUser);
%>

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo">AM</div>
        <div>
            <h2>Inf A 2024</h2>
            <p>Dari Iman ke Aksi</p>
        </div>
    </div>

    <div class="islamic-sidebar-note">
        <strong>Al-Muraqabah</strong>
        <span>Ilmu, iman, dan teknologi diwujudkan dalam kehadiran yang jujur.</span>
    </div>

    <nav class="sidebar-menu">
        <div class="sidebar-menu-group">Sering Dipakai</div>
        <% if (isStudentUser) { %>
            <a href="/scan" class="sidebar-link"><img src="<%= iconPath %>scan.svg" alt=""><span>Scan QR</span></a>
        <% } %>
        <% if (isLecturerUser || isKosmaUser || isAdminUser || isStudentUser) { %>
            <a href="/create-session" class="sidebar-link"><img src="<%= iconPath %>session.svg" alt=""><span>Buat Sesi</span></a>
        <% } %>
        <a href="/dashboard" class="sidebar-link"><img src="<%= iconPath %>dashboard.svg" alt=""><span>Dashboard</span></a>
        <% if (canUseReportMenu) { %>
            <a href="/attendance-reports" class="sidebar-link"><img src="<%= iconPath %>report.svg" alt=""><span>Laporan</span></a>
        <% } %>

        <div class="sidebar-menu-group">Akademik</div>
        <a href="/subjects" class="sidebar-link"><img src="<%= iconPath %>subjects.svg" alt=""><span>Mata Kuliah</span></a>

        <% if (isAdminUser || isKosmaUser || isLecturerUser) { %>
            <a href="/gps-settings" class="sidebar-link"><img src="<%= iconPath %>location.svg" alt=""><span>Lokasi Kelas</span></a>
        <% } %>

        <% if (isAdminUser || isKosmaUser) { %>
            <div class="sidebar-menu-group">Pengaturan</div>
            <a href="/users" class="sidebar-link"><img src="<%= iconPath %>users.svg" alt=""><span>Manajemen User</span></a>
            <a href="/class-profile" class="sidebar-link"><img src="<%= iconPath %>class.svg" alt=""><span>Profil Kelas</span></a>
            <a href="/galleries" class="sidebar-link"><img src="<%= iconPath %>gallery.svg" alt=""><span>Galeri</span></a>
        <% } %>

        <a href="/profile" class="sidebar-link"><img src="<%= iconPath %>profile.svg" alt=""><span>Profil</span></a>
    </nav>

    <div class="sidebar-profile">
        <div class="sidebar-avatar"><%= currentUser && currentUser.nama ? currentUser.nama.charAt(0).toUpperCase() : 'U' %></div>
        <div>
            <strong><%= currentUser ? currentUser.nama : 'User' %></strong>
            <small><%= isKosmaUser ? 'Kosma' : (currentUser ? currentUser.role : '-') %></small>
        </div>
    </div>

    <a href="/logout" class="logout-link">Logout</a>
</aside>

<header class="topbar">
    <div>
        <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h1>
        <p><%= typeof pageSubtitle !== 'undefined' ? pageSubtitle : 'Portal Digital Informatika A 2024' %></p>
    </div>

    <div class="topbar-actions">
        <a href="/profile" class="topbar-profile">
            <div class="avatar"><%= currentUser && currentUser.nama ? currentUser.nama.charAt(0).toUpperCase() : 'U' %></div>
            <div>
                <strong><%= currentUser ? currentUser.nama : 'User' %></strong>
                <small><%= isKosmaUser ? 'Kosma' : (currentUser ? currentUser.role : '-') %></small>
            </div>
        </a>
        <a href="/logout" class="btn-logout-top">Logout</a>
    </div>
</header>

<nav class="mobile-bottom-nav">
    <% if (isStudentUser) { %><a href="/scan"><img src="<%= iconPath %>scan.svg" alt=""><span>Scan</span></a><% } %>
    <% if (isAdminUser || isKosmaUser || isLecturerUser) { %><a href="/create-session"><img src="<%= iconPath %>session.svg" alt=""><span>Sesi</span></a><% } %>
    <a href="/dashboard"><img src="<%= iconPath %>dashboard.svg" alt=""><span>Home</span></a>
    <% if (canUseReportMenu) { %><a href="/attendance-reports"><img src="<%= iconPath %>report.svg" alt=""><span>Laporan</span></a><% } %>
    <a href="/subjects"><img src="<%= iconPath %>subjects.svg" alt=""><span>Matkul</span></a>
    <a href="/profile"><img src="<%= iconPath %>profile.svg" alt=""><span>Profil</span></a>
    <a href="/logout"><img src="<%= iconPath %>logout.svg" alt=""><span>Keluar</span></a>
</nav>
