<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Validasi GPS | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="main-content">
    <section class="content-card form-card text-center">
        <span class="value-badge">Validasi Amanah</span>
        <h2>📍 Validasi Lokasi</h2>
        <p>Pastikan Anda berada di area kelas. Radius sesi ini <%= gpsRadiusMeters || 500 %> meter.</p>

        <div class="islamic-message-box">
            <h3><%= subjectName || 'Mata Kuliah' %></h3>
            <p><%= sessionTitle || 'Sesi Absensi' %></p>
        </div>

        <button type="button" class="btn-primary" onclick="submitGpsAttendance()">Validasi GPS & Simpan Kehadiran</button>
        <p id="gpsStatus" class="info">Menunggu validasi lokasi...</p>
        <a href="/scan" class="btn-secondary">Scan Ulang</a>
    </section>
</main>

<div id="attendancePopup" class="attendance-popup" hidden>
    <div class="attendance-popup__backdrop" onclick="closeAttendancePopup()"></div>
    <div class="attendance-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="attendancePopupTitle">
        <span id="attendancePopupBadge" class="attendance-popup__badge">Status Absensi</span>
        <h2 id="attendancePopupTitle">Absensi</h2>
        <p id="attendancePopupMessage"></p>
        <button type="button" class="btn-primary" onclick="closeAttendancePopup()">Tutup</button>
    </div>
</div>

<script>
const token = '<%= token %>';
const csrfToken = '<%= csrfToken %>';
const gpsStatus = document.getElementById('gpsStatus');
const attendancePopup = document.getElementById('attendancePopup');
const attendancePopupBadge = document.getElementById('attendancePopupBadge');
const attendancePopupTitle = document.getElementById('attendancePopupTitle');
const attendancePopupMessage = document.getElementById('attendancePopupMessage');

function showAttendancePopup(success, message) {
    attendancePopup.classList.toggle('is-success', success);
    attendancePopup.classList.toggle('is-error', !success);
    attendancePopupBadge.innerText = success ? 'Absensi Berhasil' : 'Absensi Gagal';
    attendancePopupTitle.innerText = success ? 'Absensi berhasil' : 'Absensi gagal';
    attendancePopupMessage.innerText = message || (success ? 'Absensi berhasil disimpan.' : 'Absensi gagal diproses.');
    attendancePopup.hidden = false;
}

function closeAttendancePopup() {
    attendancePopup.hidden = true;
}

function submitGpsAttendance() {
    if (!navigator.geolocation) {
        const message = 'Browser tidak mendukung GPS.';
        gpsStatus.innerText = message;
        showAttendancePopup(false, message);
        return;
    }

    gpsStatus.innerText = 'Mengambil lokasi presisi tinggi...';
    navigator.geolocation.getCurrentPosition(async (position) => {
        try {
            gpsStatus.innerText = 'Mengirim data kehadiran...';
            const response = await fetch('/api/absen-gps', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
                body: JSON.stringify({
                    token,
                    latitude: position.coords.latitude,
                    longitude: position.coords.longitude,
                    gps_accuracy: position.coords.accuracy
                })
            });
            const data = await response.json();
            gpsStatus.innerText = data.message || 'Selesai.';
            if (data.success) {
                setTimeout(() => {
                    window.location.href = `/scan-success?success=true&message=${encodeURIComponent(data.message)}`;
                }, 1000);
            } else {
                showAttendancePopup(false, data.message || 'Absensi gagal diproses.');
            }
        } catch (error) {
            const message = 'Gagal menyimpan absensi karena koneksi bermasalah atau server tidak merespons.';
            gpsStatus.innerText = message;
            showAttendancePopup(false, message);
        }
    }, () => {
        const message = 'Gagal mengambil GPS karena izin lokasi belum aktif atau lokasi presisi tinggi belum tersedia.';
        gpsStatus.innerText = message;
        showAttendancePopup(false, message);
    }, { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 });
}

window.addEventListener('load', submitGpsAttendance);
</script>
</body>
</html>
