<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Absensi | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="main-content report-main">
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success no-print"><%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error no-print"><%= error %></div><% } %>

    <section class="content-card report-toolbar no-print">
        <div class="dashboard-section-header">
            <div>
                <span class="value-badge">Laporan Kehadiran</span>
                <h2>Cetak Laporan Absensi</h2>
                <p>Pilih mata kuliah dan sesi, lalu cetak laporan untuk arsip kelas.</p>
            </div>
            <div class="button-row report-actions">
                <% if (selectedSession) { %>
                    <a class="btn-primary report-print-btn" href="/attendance-reports.pdf?subject_id=<%= selectedSubjectId %>&session_id=<%= selectedSessionId %>">Unduh PDF</a>
                <% } %>
                <button type="button" class="btn-secondary report-print-btn" onclick="window.print()">Print Browser</button>
            </div>
        </div>

        <form method="GET" action="/attendance-reports" class="report-filter-form">
            <label>
                Mata Kuliah
                <select name="subject_id" onchange="this.form.submit()">
                    <% subjects.forEach(subject => { %>
                        <option value="<%= subject.id %>" <%= String(subject.id) === String(selectedSubjectId) ? 'selected' : '' %>>
                            <%= subject.name %><%= subject.code ? ' - ' + subject.code : '' %>
                        </option>
                    <% }) %>
                </select>
            </label>

            <label>
                Sesi Absensi
                <select name="session_id" onchange="this.form.submit()" <%= !sessions || sessions.length === 0 ? 'disabled' : '' %>>
                    <% if (!sessions || sessions.length === 0) { %>
                        <option>Belum ada sesi</option>
                    <% } else { %>
                        <% sessions.forEach(session => { %>
                            <option value="<%= session.id %>" <%= String(session.id) === String(selectedSessionId) ? 'selected' : '' %>>
                                <%= session.judul || 'Tanpa Judul' %> - <%= session.created_at || '-' %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </label>

                    <button type="submit" class="btn-secondary">Tampilkan</button>
        </form>
    </section>

    <section class="content-card report-sheet">
        <div class="report-letterhead">
            <div class="brand-logo">AM</div>
            <div>
                <h2>INFORMATIKA A 2024</h2>
                <p>Al-Muraqabah Integrated Attendance System</p>
                <small>Laporan kehadiran perkuliahan berbasis QR dan validasi GPS</small>
            </div>
        </div>

        <% if (!selectedSession) { %>
            <div class="empty-state">Belum ada sesi absensi untuk mata kuliah ini.</div>
        <% } else { %>
            <div class="report-document-title">
                <h1>LAPORAN ABSENSI PERKULIAHAN</h1>
                <p>Dokumen administrasi kehadiran mahasiswa</p>
            </div>

            <div class="report-meta-grid">
                <div><span>Mata Kuliah</span><strong><%= selectedSubject ? selectedSubject.name : '-' %></strong></div>
                <div><span>Kode</span><strong><%= selectedSubject && selectedSubject.code ? selectedSubject.code : '-' %></strong></div>
                <div><span>Sesi</span><strong><%= selectedSession.judul || 'Tanpa Judul' %></strong></div>
                <div><span>Dibuat</span><strong><%= selectedSession.created_at || '-' %></strong></div>
                <div><span>Berakhir</span><strong><%= selectedSession.expires_at || '-' %></strong></div>
                <div><span>Dicetak Oleh</span><strong><%= user.nama || user.nim %></strong></div>
            </div>

            <div class="report-summary-grid">
                <div><span>Total Mahasiswa</span><strong><%= summary.total %></strong></div>
                <div><span>Hadir</span><strong><%= summary.hadir %></strong></div>
                <div><span>Izin</span><strong><%= summary.izin %></strong></div>
                <div><span>Sakit</span><strong><%= summary.sakit %></strong></div>
                <div><span>Alpha</span><strong><%= summary.alpha %></strong></div>
            </div>

            <div class="table-wrapper report-table-wrapper">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>NIM</th>
                            <th>Nama</th>
                            <th>Status</th>
                            <th class="no-print">Ubah Keterangan</th>
                            <th>Waktu</th>
                            <th>Metode</th>
                            <th>Keterangan</th>
                            <th>Jarak</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach((row, index) => { %>
                            <tr>
                                <td data-label="No"><%= index + 1 %></td>
                                <td data-label="NIM"><%= row.nim %></td>
                                <td data-label="Nama"><strong><%= row.nama %></strong></td>
                                <td data-label="Status">
                                    <span class="badge <%= row.status === 'hadir' ? 'hadir' : (row.status === 'izin' ? 'izin' : (row.status === 'sakit' ? 'sakit' : 'alpha')) %>">
                                        <%= row.status === 'hadir' ? 'Hadir' : (row.status === 'izin' ? 'Izin' : (row.status === 'sakit' ? 'Sakit' : 'Alpha')) %>
                                    </span>
                                </td>
                                <td class="no-print" data-label="Ubah Keterangan">
                                    <form action="/attendance-reports/status" method="POST" class="attendance-status-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="subject_id" value="<%= selectedSubjectId %>">
                                        <input type="hidden" name="session_id" value="<%= selectedSessionId %>">
                                        <input type="hidden" name="nim" value="<%= row.nim %>">
                                        <select name="status" aria-label="Status <%= row.nama %>">
                                            <option value="hadir" <%= row.status === 'hadir' ? 'selected' : '' %>>Hadir</option>
                                            <option value="izin" <%= row.status === 'izin' ? 'selected' : '' %>>Izin</option>
                                            <option value="sakit" <%= row.status === 'sakit' ? 'selected' : '' %>>Sakit</option>
                                            <option value="alpha" <%= row.status === 'alpha' ? 'selected' : '' %>>Alpha</option>
                                        </select>
                                        <input type="text" name="note" value="<%= row.note || '' %>" placeholder="Keterangan">
                                        <button type="submit" class="btn-small">Simpan</button>
                                    </form>
                                </td>
                                <td data-label="Waktu"><%= row.created_at || '-' %></td>
                                <td data-label="Metode"><%= row.method || '-' %></td>
                                <td data-label="Keterangan"><%= row.note || '-' %></td>
                                <td data-label="Jarak"><%= row.distance_meters === null || row.distance_meters === undefined ? '-' : Math.round(Number(row.distance_meters)) + ' m' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="report-signature">
                <div>
                    <span>Dicetak oleh</span>
                    <strong><%= user.nama || user.nim %></strong>
                    <em><%= new Date().toLocaleString('id-ID') %></em>
                </div>
            </div>
        <% } %>
    </section>
</main>
</body>
</html>
