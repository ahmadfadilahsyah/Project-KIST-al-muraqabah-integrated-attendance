<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profile.class_name || 'Informatika A 2024' %> | Al-Muraqabah</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="public-page">
    <header class="public-nav">
        <div class="public-brand">
            <% if (profile.logo_url) { %>
                <img src="<%= profile.logo_url %>" alt="Logo kelas" class="public-logo-img">
            <% } else { %>
                <div class="brand-logo">AM</div>
            <% } %>
            <div>
                <strong><%= profile.class_name || 'Informatika A 2024' %></strong>
                <small><%= profile.generation || 'Angkatan 2024' %> - Portal Digital Kelas</small>
            </div>
        </div>
        <div class="public-nav-actions">
            <% if (profile.instagram_url) { %>
                <a href="<%= profile.instagram_url %>" target="_blank" rel="noopener" class="social-icon-link" aria-label="Instagram kelas">
                    <img src="/img/icons/instagram.svg" alt="">
                </a>
            <% } %>
            <a href="/login" class="btn-primary">Login</a>
        </div>
    </header>

    <main class="public-main">
        <section class="public-hero public-hero-slideshow">
            <div class="hero-slides" aria-hidden="true">
                <% const heroSlides = (galleries && galleries.length ? galleries.map(item => item.image_url) : []).slice(0, 5); %>
                <% if (heroSlides.length) { %>
                    <% heroSlides.forEach((imageUrl, index) => { %>
                        <div class="hero-slide <%= index === 0 ? 'is-active' : '' %>" style="background-image: url('<%= imageUrl %>');"></div>
                    <% }) %>
                <% } else if (profile.hero_image_url) { %>
                    <div class="hero-slide is-active" style="background-image: url('<%= profile.hero_image_url %>');"></div>
                <% } %>
            </div>
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <span class="value-badge">Dari Iman ke Aksi</span>
                <h1><%= profile.class_name || 'Website Kelas Informatika A 2024' %></h1>
                <p><%= profile.description || 'Portal kelas yang merawat ilmu, adab, Shidiq, dan Amanah melalui informasi akademik, berita kegiatan, dokumentasi, serta absensi digital yang transparan.' %></p>
                <div class="button-row center">
                    <a href="#galeri" class="btn-primary">Lihat Galeri</a>
                    <a href="#berita" class="btn-secondary">Lihat Berita</a>
                </div>
            </div>
        </section>

        <section class="public-stats">
            <div class="stat-card"><p>Mahasiswa Aktif</p><h2><%= stats.totalMahasiswa || 0 %></h2></div>
            <div class="stat-card"><p>Dosen Aktif</p><h2><%= stats.totalDosen || 0 %></h2></div>
            <div class="stat-card"><p>Mata Kuliah</p><h2><%= stats.totalMatkul || 0 %></h2></div>
        </section>

        <section class="public-values">
            <article>
                <span>01</span>
                <h3>Iman</h3>
                <p>Kesadaran bahwa belajar adalah ibadah dan setiap amanah akademik bernilai di sisi Allah.</p>
            </article>
            <article>
                <span>02</span>
                <h3>Shidiq</h3>
                <p>Jujur dalam kehadiran, data, komunikasi kelas, dan proses menuntut ilmu.</p>
            </article>
            <article>
                <span>03</span>
                <h3>Amanah</h3>
                <p>Bertanggung jawab atas waktu, tugas, peran PJ, dan kepercayaan yang diberikan.</p>
            </article>
        </section>

        <section id="profil" class="content-card public-card public-profile-card">
            <span class="value-badge">Al-Muraqabah</span>
            <h2>Tentang Kelas</h2>
            <p><%= profile.description || 'Informatika A 2024 adalah kelas yang berfokus pada kolaborasi, disiplin akademik, dan pengembangan kompetensi informatika. Portal ini menjadi ruang digital untuk mendukung kegiatan kelas secara transparan dan terstruktur.' %></p>
            <div class="public-contact-row">
                <% if (profile.instagram_url) { %>
                    <a href="<%= profile.instagram_url %>" target="_blank" rel="noopener" class="btn-secondary">Instagram Kelas</a>
                <% } %>
                <% if (profile.email) { %>
                    <a href="mailto:<%= profile.email %>" class="btn-secondary"><%= profile.email %></a>
                <% } %>
            </div>
        </section>

        <section id="berita" class="public-news-section">
            <div class="public-section-heading">
                <span class="value-badge">Berita Kelas</span>
                <h2>Kabar Ilmu, Adab, dan Amanah</h2>
                <p>Rangkuman kegiatan kelas yang ditulis untuk menjaga budaya Shidiq dan Amanah.</p>
            </div>

            <% if (announcements && announcements.length) { %>
                <div class="public-news-grid">
                    <% announcements.forEach((item, index) => { %>
                        <article class="public-news-card <%= index === 0 ? 'featured-news-card' : '' %>">
                            <div class="public-news-media <% if (!item.image_url) { %>public-news-media-empty<% } %>">
                                <% if (item.image_url) { %>
                                    <img src="<%= item.image_url %>" alt="<%= item.title %>">
                                <% } else { %>
                                    <span>Al-Muraqabah</span>
                                <% } %>
                            </div>
                            <div class="public-news-content">
                                <div class="news-meta"><%= item.published_at || item.created_at || '-' %> - <%= item.author_name || 'Admin Kelas' %></div>
                                <h3><%= item.title %></h3>
                                <p><%= item.content.length > 180 ? item.content.substring(0, 180) + '...' : item.content %></p>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">Belum ada berita publik.</div>
            <% } %>
        </section>

        <section class="public-grid public-support-grid">
            <div class="content-card inner-card">
                <h2>Jadwal Kuliah</h2>
                <% if (schedules && schedules.length) { %>
                    <div class="public-list">
                        <% schedules.forEach(item => { %>
                            <article class="public-list-item">
                                <strong><%= item.day %> - <%= item.start_time || '-' %> sampai <%= item.end_time || '-' %></strong>
                                <p><%= item.subject_name || 'Mata kuliah' %><% if (item.room) { %> - <%= item.room %><% } %></p>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p>Jadwal akan tampil setelah admin/kosma mengisi data.</p>
                <% } %>
            </div>

            <div class="content-card inner-card">
                <h2>Absensi Digital Amanah</h2>
                <p>QR dinamis dan validasi GPS membantu kelas menjaga kejujuran. Data hadir bukan sekadar angka, tetapi latihan Shidiq dalam rutinitas akademik.</p>
            </div>
        </section>

        <section id="galeri" class="content-card public-card">
            <div class="dashboard-section-header">
                <div>
                    <h2>Galeri Kegiatan</h2>
                    <p>Dokumentasi kegiatan dan momen kelas.</p>
                </div>
            </div>

            <% if (galleries && galleries.length) { %>
                <div class="gallery-grid">
                    <% galleries.forEach(item => { %>
                        <article class="gallery-card">
                            <img src="<%= item.image_url %>" alt="<%= item.title %>">
                            <div>
                                <strong><%= item.title %></strong>
                                <% if (item.description) { %><p><%= item.description %></p><% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">Belum ada galeri publik.</div>
            <% } %>
        </section>
    </main>

    <footer class="public-footer">
        <strong><%= profile.class_name || 'Informatika A 2024' %></strong>
        <span>Dari Iman ke Aksi - Shidiq dan Amanah</span>
        <% if (profile.instagram_url) { %>
            <a href="<%= profile.instagram_url %>" target="_blank" rel="noopener">@abstractbanget</a>
        <% } %>
    </footer>
<script>
    const heroSlides = Array.from(document.querySelectorAll('.hero-slide'));
    let activeHeroSlide = 0;

    if (heroSlides.length > 1) {
        setInterval(() => {
            heroSlides[activeHeroSlide].classList.remove('is-active');
            activeHeroSlide = (activeHeroSlide + 1) % heroSlides.length;
            heroSlides[activeHeroSlide].classList.add('is-active');
        }, 4500);
    }
</script>
</body>
</html>
